# Copy to .env and fill in. Never commit .env.
# The values below are printed by scripts/deploy_aws.sh in its summary file.

# AWS
AWS_REGION=eu-west-2
AWS_ACCOUNT_ID=123456789012

# S3
S3_DATA_BUCKET=multiomics-prod-data-123456789012
S3_WEB_BUCKET=multiomics-prod-web-123456789012

# DynamoDB / SQS
DYNAMO_JOBS_TABLE=multiomics-prod-jobs
SQS_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/123456789012/multiomics-prod-jobs.fifo

# Cognito
COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=your_app_client_id

# Frontend (Vite only exposes VITE_* variables)
VITE_API_URL=https://api.yourdomain.com
VITE_AWS_REGION=eu-west-2
VITE_COGNITO_POOL_ID=eu-west-2_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_app_client_id
VITE_S3_DATA_BUCKET=multiomics-prod-data-123456789012

# Local
OUTPUT_DIR=./output
ALLOWED_ORIGINS=http://localhost:5173
